{
  "name": "pushpad",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vinext dev --port 3010",
    "build": "vinext build",
    "start": "vinext start",
    "predeploy": "npm run typecheck && npm run build",
    "deploy": "wrangler secret bulk .secrets.json && vinext build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "tsc": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply pushpad-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply pushpad-db --remote",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:prod": "tsx scripts/seed.ts --prod",
    "secrets:push": "wrangler secret bulk .secrets.json"
  },
  "dependencies": {
    "@auth/core": "^0.41.2",
    "@auth/drizzle-adapter": "^1.11.2",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tanstack/react-query": "^5.62.0",
    "@trpc/client": "^11.14.0",
    "@trpc/next": "^11.14.0",
    "@trpc/react-query": "^11.14.0",
    "@trpc/server": "^11.14.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.0",
    "nanoid": "^5.0.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "superjson": "^2.2.2",
    "tailwind-merge": "^2.6.0",
    "vinext": "^1.4.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.30.0",
    "@cloudflare/workers-types": "^4.20260301.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitejs/plugin-rsc": "^0.5.38",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.30.0",
    "postcss": "^8.4.49",
    "react-server-dom-webpack": "^19.3.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "wrangler": "^4.87.0"
  }
}
